# Public site URL used for checkout return links.
NEXT_PUBLIC_SITE_URL=https://9emas.netlify.app

# Paste these from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Leave blank until the live account is connected.
# STRIPE_PRICE_ID is optional. Without it, checkout creates the $31.99 monthly price.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Password for /admin/subscribers. Do not commit a real value.
ADMIN_SECRET=
